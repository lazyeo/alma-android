{
  "name": "alma-mobile",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "dev:lan": "ALMA_MOBILE_HTTPS=1 vite --host 0.0.0.0 --port 5174",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "format": "prettier --write src scripts docs README.md capacitor.config.ts vite.config.ts",
    "format:check": "prettier --check src scripts docs README.md capacitor.config.ts vite.config.ts",
    "check": "npm run typecheck && npm run test && npm run format:check",
    "smoke": "tsx scripts/relay-smoke.mjs",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && JAVA_HOME=/opt/homebrew/opt/openjdk@21 ANDROID_HOME=$HOME/Library/Android/sdk ./android/gradlew -p android assembleDebug",
    "android:run": "npm run android:build && node scripts/android-run.mjs",
    "android:release": "npm run android:sync && JAVA_HOME=/opt/homebrew/opt/openjdk@21 ANDROID_HOME=$HOME/Library/Android/sdk ./android/gradlew -p android assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@tanstack/react-virtual": "^3.13.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "@zxing/browser": "^0.1.5",
    "docx-preview": "^0.4.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.60.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.1",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.7.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "ws": "^8.18.3"
  },
  "license": "MIT"
}
